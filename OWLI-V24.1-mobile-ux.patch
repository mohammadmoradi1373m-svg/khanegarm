<script>
(function(){
  function avoidChatFabOverlap(){
    const fab=document.querySelector('.chat-fab');
    if(!fab || window.innerWidth>720) return;
    const fr=fab.getBoundingClientRect();
    const cards=[...document.querySelectorAll('[data-route="/"] .premium-product-card')];
    const hit=cards.some(el=>{
      const r=el.getBoundingClientRect();
      return r.bottom>fr.top&&r.top<fr.bottom&&r.right>fr.left&&r.left<fr.right;
    });
    fab.classList.toggle('chat-fab-obscured',hit);
  }
  let raf=0;
  function schedule(){
    cancelAnimationFrame(raf);
    raf=requestAnimationFrame(avoidChatFabOverlap);
  }
  window.addEventListener('scroll',schedule,{passive:true});
  window.addEventListener('resize',schedule,{passive:true});
  document.addEventListener('DOMContentLoaded',schedule);
  setTimeout(schedule,500);
})();
</script>
